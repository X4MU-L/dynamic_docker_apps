FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY cli ./cli
RUN cd cli && CGO_ENABLED=0 go build -o /app/discover_cli .

FROM alpine:latest
RUN apk add --no-cache docker-cli ca-certificates python3
WORKDIR /app
COPY --from=builder /app/discover_cli /app/discover_cli
ENTRYPOINT ["/app/discover_cli", "discover", "--api-url", "http://pingora-lb:8081"]
